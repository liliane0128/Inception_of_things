# -*- mode: ruby -*-
# vi: set ft=ruby :

LOGIN      = "lilwang"
BOX        = "perk/ubuntu-2204-arm64"
SERVER_IP  = "192.168.56.110"
NETMASK    = "255.255.255.0"

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP, netmask: NETMASK

    server.vm.provider "qemu" do |qe|
      qe.memory = "1024"
      qe.smp = "1"
      qe.advanced_network = true
      qe.net_mode = :socket_vmnet
      qe.ssh_auto_correct = true
    end

    server.vm.provision "shell",
      path: "scripts/install_k3s.sh",
      env: { "NODE_IP" => SERVER_IP }

    # vagrant-qemu doesn't mount the default /vagrant synced folder, so copy
    # the manifests over explicitly before applying them.
    server.vm.provision "file",
      source: "confs",
      destination: "/home/vagrant/confs"

    server.vm.provision "shell",
      path: "scripts/deploy_apps.sh"
  end
end
