# -*- mode: ruby -*-
# vi: set ft=ruby :

LOGIN      = "lilwang"
BOX        = "generic/ubuntu2204"
SERVER_IP  = "192.168.56.110"
NETMASK    = "255.255.255.0"

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP, netmask: NETMASK

    server.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}S"
      vb.memory = "1024"
      vb.cpus = 1
    end

    server.vm.provision "shell",
      path: "scripts/install_k3s.sh",
      env: { "NODE_IP" => SERVER_IP }

    # Explicit copy instead of relying on the default /vagrant synced folder
    # (keeps this identical across providers/hosts regardless of Guest
    # Additions being present in the box).
    server.vm.provision "file",
      source: "confs",
      destination: "/home/vagrant/confs"

    server.vm.provision "shell",
      path: "scripts/deploy_apps.sh"
  end
end
